# OpenAI API key (required for ingest — Vision analysis)
OPENAI_API_KEY=your_key_here

# Telegram Bot Token (required for telegram_bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: path to SQLite database (default: errors.db in project root)
# DB_PATH=errors.db

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: directory for temp files (e.g. uploaded zip)
TEMP_DIR=tmp
